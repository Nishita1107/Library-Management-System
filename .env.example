# Server Configuration
PORT=5000

# MongoDB Database Connection String
# Replace with your own MongoDB Atlas connection URI:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/libraryDB?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://nishita:YOUR_PASSWORD@cluster0.mongodb.net/libraryDB?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=rait_library_super_secret_jwt_key_2026

# Razorpay Payment Gateway Credentials (Test Keys)
# Generate from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Reminders (Nodemailer)
# Use your Gmail address and 16-character App Password (from Google Account -> Security -> 2-Step Verification -> App passwords)
EMAIL_USER=nishitadms@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_SERVICE=gmail
